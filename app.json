{
  "expo": {
    "name": "Flood Check",
    "slug": "flood-check",
    "version": "1.0.0",
    "description": "Real-time flood monitoring app for Windward Oʻahu providing local water level data, maps, and safety alerts.",
    "icon": "./assets/images/icon.png",
    "scheme": "flood-check",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b3aa46d1-9493-4256-be23-aa67df85c6d1"
      }
    },
    "owner": "chiaraduyn",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "edu.hawaii.wrrc",
      "appleTeamId": "B8Y298FMLQ",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font"
    ],
    "android": {
      "package": "edu.hawaii.wrrc",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    }
  }
}
